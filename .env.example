# Copia este archivo a ".env" y ajusta los valores. NUNCA subas ".env" al repositorio.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos ---
# Si DATABASE_URL no se define, se usa SQLite local (solo para desarrollo).
# Ejemplo PostgreSQL: postgres://usuario:password@localhost:5432/booru
DATABASE_URL=

# --- CORS / Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seguridad para producción ---
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# --- Email (verificación / recuperación de contraseña) ---
# En desarrollo se usa el backend de consola por defecto.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_FAIL_SILENTLY=False
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Frontend (para construir enlaces de verificación / reset) ---
FRONTEND_URL=http://localhost:5173

# --- Almacenamiento S3 (producción) ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=

# --- Content Moderation ---
# Proveedores disponibles: (empty/None en desarrollo), aws_rekognition, azure
# Si no se configura, se usa pass-through (ninguna moderación)
CONTENT_MODERATION_PROVIDER=
CONTENT_MODERATION_API_KEY=
CONTENT_MODERATION_WEBHOOK_SECRET=

